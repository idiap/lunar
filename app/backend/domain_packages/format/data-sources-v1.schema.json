{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lunar:domain-package:data-sources-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "descriptor": {
      "type": "object"
    },
    "local_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "file": {
            "type": "string",
            "pattern": "^(repository|reports|skills|data-sources)/[^\\\\\\x00]+$"
          }
        },
        "required": [
          "id",
          "file"
        ]
      }
    },
    "remote_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "uri"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "descriptor",
    "local_files",
    "remote_references"
  ]
}
