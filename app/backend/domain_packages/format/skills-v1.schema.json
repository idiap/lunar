{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lunar:domain-package:skills-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "invocation": {
      "type": "object"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "instructions",
    "capabilities",
    "invocation",
    "groups",
    "metadata"
  ]
}
