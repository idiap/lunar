FROM python:3.13-slim
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir uv==0.11.14
WORKDIR /opt/bootstrap
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --only-group mcp-backend
ENV PATH="/opt/bootstrap/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1
WORKDIR /output
LABEL org.lunar.role="worker-base"
