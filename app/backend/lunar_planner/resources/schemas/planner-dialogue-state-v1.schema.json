{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/planner-dialogue-state-v1.schema.json",
  "title": "Lunar caller-held dialogue planner state v1",
  "type": "object",
  "required": ["schema_version", "dialogue_id", "turn_index", "snapshot_digest", "turns", "active_goal", "facts", "active_inputs", "references", "authority", "constraints", "assumptions", "open_decisions", "requirement_ledger", "workflow_draft", "workflow_instantiation", "proposed_skill_test_plans", "workflow_refinement_cycle", "question_history", "planning_phase", "digest"],
  "properties": {
    "schema_version": {"const": "lunar.planner.dialogue-state/v1"},
    "dialogue_id": {"type": "string", "pattern": "^dialogue-[a-z0-9]+$"},
    "turn_index": {"type": "integer", "minimum": 1},
    "parent_stage_digest": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "current_stage_digest": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "turns": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "active_goal": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "items": {"type": "object"}},
    "fact_events": {"type": "array", "items": {"type": "object"}},
    "active_inputs": {"type": "object"},
    "references": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array"},
    "open_decisions": {"type": "array"},
    "requirement_ledger": {"$ref": "https://bioagents.local/schemas/planner-requirement-ledger-v1.schema.json"},
    "workflow_draft": {"$ref": "https://bioagents.local/schemas/planner-workflow-draft-v1.schema.json"},
    "workflow_instantiation": {"oneOf": [{"$ref": "https://bioagents.local/schemas/planner-workflow-instantiation-v1.schema.json"}, {"type": "null"}]},
    "proposed_skill_test_plans": {"type": "array", "items": {"$ref": "https://bioagents.local/schemas/planner-proposed-skill-test-plan-v1.schema.json"}},
    "post_plan_evidence_verification": {"$ref": "https://bioagents.local/schemas/planner-post-plan-evidence-verification-v1.schema.json"},
    "workflow_refinement_cycle": {"oneOf": [{"$ref": "https://bioagents.local/schemas/planner-workflow-refinement-cycle-v1.schema.json"}, {"type": "null"}]},
    "capability_gap_plan": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "question_history": {"type": "array", "items": {"type": "object"}},
    "planning_phase": {"enum": ["framing", "eliciting", "draft_workflow", "ready_for_review", "ready_for_delivery"]},
    "quality_phase": {"enum": ["quality_intent_clarification_required", "quality_planning_required", "delivery_quality_planning_required"]},
    "entrypoint_mode": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
