{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bioagents.provider-family/v1", "type": "object",
  "required": ["schema_version", "skill_id", "purpose", "consumes", "produces", "providers"],
  "properties": {
    "schema_version": {"const": "bioagents.provider-family/v1"}, "contract_completeness": {"enum": ["legacy", "complete"]}, "skill_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
    "positive_applicability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "negative_applicability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "consumes": {"type": "array", "items": {"$ref": "#/$defs/port"}}, "requires": {"type": "array", "items": {"$ref": "#/$defs/port"}}, "produces": {"type": "array", "items": {"$ref": "#/$defs/port"}}, "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}},
    "authority": {"$ref": "#/$defs/authority"}, "failure_contract": {"$ref": "#/$defs/failure_contract"}, "fallback": {"$ref": "#/$defs/fallback"},
    "conversion_edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "lossy"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "lossy": {"type": "boolean"}, "validation_fixture": {"type": "string"}}, "additionalProperties": false}}
  },
  "allOf": [{"if": {"properties": {"contract_completeness": {"const": "complete"}}, "required": ["contract_completeness"]}, "then": {"required": ["positive_applicability", "negative_applicability", "requires", "authority", "failure_contract", "fallback"], "properties": {"providers": {"items": {"required": ["adapter_version", "dependency_preflight", "authority"]}}}}}],
  "$defs": {
    "port": {"type": "object", "required": ["name", "type", "cardinality"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "cardinality": {"type": "string"}, "format": {"type": "string"}, "namespace": {"type": "string"}, "genome_build": {"type": "string"}, "missingness": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["kind", "name"], "properties": {"kind": {"enum": ["python_package", "r_package", "command", "local_checkout", "write_location", "credential", "network_policy", "gpu", "memory", "platform", "side_effect_policy", "data_egress_policy", "cost_policy"]}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string"}, "module": {"type": "string"}, "path": {"type": "string"}}, "additionalProperties": true},
    "authority_value": {"enum": ["required", "not_required", "unknown"]},
    "authority": {"type": "object", "required": ["installation", "network", "credentials", "data_egress", "cost", "side_effects"], "properties": {"installation": {"$ref": "#/$defs/authority_value"}, "network": {"$ref": "#/$defs/authority_value"}, "credentials": {"$ref": "#/$defs/authority_value"}, "data_egress": {"$ref": "#/$defs/authority_value"}, "cost": {"$ref": "#/$defs/authority_value"}, "side_effects": {"$ref": "#/$defs/authority_value"}}, "additionalProperties": false},
    "provider": {"type": "object", "required": ["provider_id", "source_revision", "licence_status", "execution_posture"], "properties": {"provider_id": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 7}, "adapter_version": {"type": "string", "minLength": 1}, "licence_status": {"enum": ["compatible", "incompatible", "unknown"]}, "execution_posture": {"enum": ["documented", "compatible", "installed", "fixture_tested", "execution_tested"]}, "dependency_preflight": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "authority": {"$ref": "#/$defs/authority"}}, "additionalProperties": true},
    "failure_contract": {"type": "object", "required": ["schema_version", "codes"], "properties": {"schema_version": {"const": "bioagents.provider-error/v1"}, "codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "fallback": {"type": "object", "required": ["alternative_provider", "dynamic_discovery", "skill_gap", "terminal_incompatibility"], "properties": {"alternative_provider": {"type": "boolean"}, "dynamic_discovery": {"type": "boolean"}, "skill_gap": {"type": "boolean"}, "terminal_incompatibility": {"type": "boolean"}}, "additionalProperties": false}
  }, "additionalProperties": true
}
