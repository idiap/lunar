{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/reasoning-log-v1.schema.json",
  "title": "Lunar normalized reasoning log v1",
  "type": "object",
  "required": [
    "schema_version", "log_id", "subject", "status", "summary", "entries",
    "assumptions", "evidence_references", "blockers", "limitations",
    "visibility", "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "lunar.reasoning-log/v1"},
    "log_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["skill", "planner", "subworkflow", "workflow", "data_source_query", "kb_query"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["planned", "running", "completed", "blocked", "failed", "partial"]},
    "summary": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "visibility": {
      "type": "object",
      "required": ["user_surfaceable", "detail_level", "contains_hidden_chain_of_thought", "redactions"],
      "additionalProperties": false,
      "properties": {
        "user_surfaceable": {"const": true},
        "detail_level": {"const": "decision_trace"},
        "contains_hidden_chain_of_thought": {"const": false},
        "redactions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["id", "kind", "locator"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["input", "source", "artifact", "contract", "test", "catalog_snapshot"]},
        "locator": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id", "sequence", "stage", "actor", "action", "rationale_summary",
        "inputs_used", "decision", "outputs", "checks", "blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "stage": {"type": "string", "minLength": 1},
        "actor": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["skill", "planner", "workflow", "deterministic_check", "human"]},
            "id": {"type": "string", "minLength": 1}
          }
        },
        "action": {"type": "string", "minLength": 1},
        "rationale_summary": {"type": "string", "minLength": 1},
        "inputs_used": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decision": {
          "type": "object",
          "required": ["status", "outcome", "alternatives_considered"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["selected", "accepted", "rejected", "deferred", "blocked", "informational"]},
            "outcome": {"type": "string", "minLength": 1},
            "alternatives_considered": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
