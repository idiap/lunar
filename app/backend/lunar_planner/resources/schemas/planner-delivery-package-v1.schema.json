{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/planner-delivery-package-v1.schema.json",
  "title": "Lunar completed-task delivery package v1",
  "type": "object",
  "required": ["schema_version", "status", "package_id", "archive_path", "archive_media_type", "archive_digest", "manifest", "planner_provenance_path", "requirement", "skill_route", "digest"],
  "properties": {
    "schema_version": {"const": "lunar.planner.delivery-package/v1"},
    "status": {"const": "ready_for_user"},
    "package_id": {"type": "string", "pattern": "^delivery-[0-9a-f]{20}$"},
    "archive_path": {"type": "string", "minLength": 1},
    "archive_media_type": {"const": "application/zip"},
    "archive_digest": {"$ref": "#/$defs/digest"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "planner_provenance_path": {"const": "provenance/planner.prov.json"},
    "requirement": {"$ref": "#/$defs/requirement"},
    "skill_route": {"const": ["completed-artifact-packager"]},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirement": {
      "type": "object",
      "required": ["schema_version", "disposition", "reason", "task_complete", "package_demanded", "artifact_count", "digest"],
      "properties": {
        "schema_version": {"const": "lunar.planner.delivery-package-requirement/v1"},
        "disposition": {"const": "package"},
        "reason": {"type": "string", "minLength": 1},
        "task_complete": {"const": true},
        "package_demanded": {"const": true},
        "artifact_count": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "package_id", "planner_result_digest", "artifact_count", "artifacts", "digest"],
      "properties": {
        "schema_version": {"const": "lunar.planner.delivery-package-manifest/v1"},
        "package_id": {"type": "string", "pattern": "^delivery-[0-9a-f]{20}$"},
        "planner_result_digest": {"$ref": "#/$defs/digest"},
        "artifact_count": {"type": "integer", "minimum": 1},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "name", "role", "package_path", "media_type", "size_bytes", "content_digest", "provenance_path", "provenance_digest"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact-[0-9a-f]{16}$"},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "package_path": {"type": "string", "pattern": "^files/[0-9]{3}-[^/]+$"},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "content_digest": {"$ref": "#/$defs/digest"},
        "provenance_path": {"type": "string", "pattern": "^provenance/artifact-[0-9a-f]{16}\\.prov\\.json$"},
        "provenance_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
