{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/subworkflow-manifest-v1.json",
  "title": "Lunar universal subworkflow manifest",
  "type": "object",
  "required": ["schema_version", "id", "version", "digest", "purpose", "concept", "promotion_evidence", "inputs", "outputs", "nodes", "bindings", "terminals", "authority", "examples"],
  "properties": {
    "schema_version": {"const": "bioagents.subworkflow/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "purpose": {"type": "string", "minLength": 1},
    "concept": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "promotion_evidence": {
      "type": "object", "required": ["contexts", "stable_boundary", "terminal_artifact"],
      "properties": {"contexts": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "stable_boundary": {"type": "string"}, "terminal_artifact": {"type": "string"}}
    },
    "inputs": {"$ref": "#/$defs/ports"},
    "outputs": {"$ref": "#/$defs/ports"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "terminals": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "from"], "properties": {"name": {"type": "string"}, "from": {"$ref": "#/$defs/endpoint"}}}},
    "gates": {"type": "array", "items": {"type": "object"}},
    "stop_rules": {"type": "array", "items": {"type": "object"}},
    "failure_policy": {"type": "object"},
    "authority": {"type": "object", "required": ["permissions", "side_effects"], "properties": {"permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["network", "read_files", "write_files", "connector", "human_review"]}}, "side_effects": {"type": "array", "items": {"type": "string"}}}},
    "examples": {"type": "object", "required": ["direct", "blocked"], "properties": {"direct": {"type": "object"}, "blocked": {"type": "object"}}},
    "erfl_projection": {"type": "object"}
  },
  "$defs": {
    "endpoint": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_]*$"},
    "ports": {"type": "array", "items": {"type": "object", "required": ["name", "type"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "required": {"type": "boolean"}, "description": {"type": "string"}}}},
    "node": {"type": "object", "required": ["id", "skill", "compatible_versions", "inputs", "outputs", "permissions"], "properties": {"id": {"type": "string"}, "skill": {"type": "string"}, "compatible_versions": {"type": "string"}, "inputs": {"$ref": "#/$defs/ports"}, "outputs": {"$ref": "#/$defs/ports"}, "permissions": {"type": "array", "items": {"type": "string"}}, "critic": {"type": "boolean"}}},
    "binding": {"type": "object", "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/endpoint"}, "to": {"$ref": "#/$defs/endpoint"}, "when": {"type": "string"}}}
  }
}
