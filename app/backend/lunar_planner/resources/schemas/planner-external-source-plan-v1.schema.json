{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/planner-external-source-plan-v1.schema.json",
  "title": "ExternalSourcePlanningPacket v1",
  "type": "object",
  "required": ["schema_version", "packet_id", "activation", "original_request", "request_digest", "problem_digest", "snapshot_digests", "data_needs", "candidate_matrix", "coverage_receipts", "query_plans", "unresolved_decisions", "access_budget_summary", "acquisition_dag", "handoffs", "sufficiency", "prospective_lineage", "zero_io"],
  "properties": {
    "schema_version": {"const": "lunar.planner.external-source-plan/v1"},
    "packet_id": {"type": "string"},
    "activation": {"enum": ["required", "not_applicable", "needs_clarification"]},
    "activation_reasons": {"type": "array"},
    "original_request": {"type": "string"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "problem_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "snapshot_digests": {"type": "object"},
    "data_needs": {"type": "array"},
    "candidate_matrix": {"type": "array"},
    "coverage_receipts": {"type": "array"},
    "query_plans": {"type": "array"},
    "unresolved_decisions": {"type": "array"},
    "access_budget_summary": {"type": "object"},
    "acquisition_dag": {"type": "object"},
    "handoffs": {"type": "array"},
    "sufficiency": {"type": "object"},
    "prospective_lineage": {"type": "array"},
    "zero_io": {"type": "object", "required": ["network", "installation", "mutation"], "properties": {"network": {"const": false}, "installation": {"const": false}, "mutation": {"const": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
