{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/planner-proposed-skill-test-plan-v1.schema.json",
  "title": "Lunar proposed skill test plan v1",
  "type": "object",
  "required": ["schema_version", "test_plan_id", "gap_id", "requirement_id", "proposed_component_class", "implementation_authorized", "test_files_written", "suggested_test_module", "test_cases", "digest"],
  "properties": {
    "schema_version": {"const": "lunar.planner.proposed-skill-test-plan/v1"},
    "test_plan_id": {"type": "string", "pattern": "^test-plan-gap-[1-9][0-9]*$"},
    "gap_id": {"type": "string", "pattern": "^gap-[1-9][0-9]*$"},
    "requirement_id": {"type": "string", "pattern": "^requirement-[1-9][0-9]*$"},
    "proposed_component_class": {"enum": ["universal", "project_specific", "adapter", "workflow_local"]},
    "implementation_authorized": {"const": false},
    "test_files_written": {"const": false},
    "suggested_test_module": {"type": "string", "pattern": "^tests/proposed/test_gap_[1-9][0-9]*\\.py$"},
    "test_cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["test_id", "purpose", "arrange", "act", "assert"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "arrange": {"type": "array"},
          "act": {"type": "string", "minLength": 1},
          "assert": {"type": "array", "minItems": 1}
        },
        "additionalProperties": false
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
