{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioagents.local/schemas/planner-profile-v1.schema.json",
  "title": "Lunar planning-only profile v1",
  "type": "object",
  "required": ["schema_version", "workflow_id", "kind", "status", "mode", "catalog_scope", "root_inputs", "release_stage_id", "stages"],
  "properties": {
    "schema_version": {"const": "lunar.planner.profile/v1"},
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "kind": {"const": "planner_profile"},
    "status": {"const": "planning_only_non_executing"},
    "mode": {"type": "string", "minLength": 1},
    "catalog_scope": {"const": "selected_package_skills_and_workflows"},
    "root_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "release_stage_id": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "owner_skill", "inputs", "outputs", "dependencies", "rule"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "owner_skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "owner_scope": {"enum": ["package", "planner"]},
          "runtime_owner": {"enum": ["lunar_planner.ports.resolve_intent", "lunar_planner.ports.build_invocation_plan", "lunar_planner.staged_routing.plan_stages"]},
          "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "rule": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "source_archive_version": {"type": "string"},
    "surface_index": {"type": "string"}
  },
  "additionalProperties": false
}
