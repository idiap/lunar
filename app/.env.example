PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
# production serves the built frontend; development enables Vite hot reload.
ENVIRONMENT=production
# Set the same absolute path inside the backend and on the Docker host.
LUNAR_PACKAGE_STORAGE_ROOT=/absolute/path/to/lunar-platform/var/packages
LUNAR_WORKER_IMAGE=lunar-worker:local
POSTGRES_DB=reports
POSTGRES_USER=reports
POSTGRES_PASSWORD=replace-with-a-database-password
# URL-encode reserved characters in the password in DATABASE_URL.
DATABASE_URL=postgresql://reports:replace-with-a-database-password@db:5432/reports
AUTH_SECRET=replace-with-a-long-random-secret
# Fernet key: 32 random bytes in URL-safe Base64, not hexadecimal (see README).
ENCRYPTION_KEY=
RESEND_API_KEY=
# For local testing: new accounts skip email and can sign in immediately.
# Accounts created with bypass enabled remain verified after disabling it.
BYPASS_VERIFICATION=false
RESEND_FROM_EMAIL=Lunar <onboarding@resend.dev>
LUNAR_ALLOW_LIVE_NETWORK=0
LUNAR_PROFILE=local
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
LUNAR_REASONING_MODEL_PROVIDER=
LUNAR_REASONING_MODEL_ID=
LUNAR_REASONING_MODEL_API_KEY=
LUNAR_REASONING_MODEL_API_BASE=
LUNAR_REASONING_MODEL_API_VERSION=
LUNAR_REASONING_MODEL_TIMEOUT_SECONDS=20
